# Resolve this before starting Compose; do not use a relative path.
WAYPOINT_DATA_DIR=/var/lib/waypoint

# The admin UI remains local and needs no UFW allow rule.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=81
HTTP_PORT=80
HTTPS_PORT=443

# Use the local resolver from /etc/resolv.conf when routes target hostnames.
NGINX_RESOLVER=127.0.0.53
