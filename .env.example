# Admin stays on loopback by default. Use an SSH tunnel for a remote server.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=81
# Existing Docker network shared by Nginx, Waypoint, and upstream apps.
NGINX_NETWORK=proxy
# Listener values used in generated server blocks; Waypoint does not publish them.
HTTP_PORT=80
HTTPS_PORT=443
